# Copy to .env and fill in real values. Never commit .env.
# Leave DATABASE_URL unset to use the default: <repo_root>/data/app.db
# DATABASE_URL=sqlite:////absolute/path/to/app.db

# Optional: if unset, LLM-backed agents (Address, Narrative) fall back to
# rule-based / template behavior automatically.
LLM_API_KEY=
LLM_PROVIDER=anthropic

MAX_UPLOAD_SIZE_MB=20
CONFIDENCE_HIGH_THRESHOLD=90
CONFIDENCE_MEDIUM_THRESHOLD=60

LOG_LEVEL=INFO
ENVIRONMENT=development
